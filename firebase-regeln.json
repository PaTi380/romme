{
  "rules": {
    ".read": false,
    ".write": false,
    "schluessel": {
      "$tisch": {
        ".read": "auth != null && root.child('tische/' + $tisch + '/plaetze/1/' + auth.uid).exists()",
        ".write": "auth != null && (!data.exists() || root.child('tische/' + $tisch + '/plaetze/1/' + auth.uid).exists())",
        "$platz": {
          ".validate": "($platz === '1' || $platz === '2' || $platz === '3' || $platz === '4') && newData.isString() && newData.val().length >= 12"
        }
      }
    },
    "tische": {
      "$tisch": {
        ".read": "auth != null && (data.child('plaetze/1/' + auth.uid).exists() || data.child('plaetze/2/' + auth.uid).exists() || data.child('plaetze/3/' + auth.uid).exists() || data.child('plaetze/4/' + auth.uid).exists())",
        "plaetze": {
          ".write": "auth != null && root.child('tische/' + $tisch + '/plaetze/1/' + auth.uid).exists()",
          "$platz": {
            "$uid": {
              ".write": "auth != null && $uid === auth.uid && ($platz === '1' || $platz === '2' || $platz === '3' || $platz === '4') && newData.val() === root.child('schluessel/' + $tisch + '/' + $platz).val()",
              ".validate": "newData.isString()"
            }
          }
        },
        "spiel": {
          ".write": "auth != null && (data.parent().child('plaetze/1/' + auth.uid).exists() || data.parent().child('plaetze/2/' + auth.uid).exists() || data.parent().child('plaetze/3/' + auth.uid).exists() || data.parent().child('plaetze/4/' + auth.uid).exists())",
          ".validate": "newData.isString() && newData.val().length < 200000"
        },
        "$sonst": {
          ".validate": false
        }
      }
    }
  }
}
