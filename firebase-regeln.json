{
  "rules": {
    ".read": false,
    ".write": false,
    "tische": {
      "$tisch": {
        ".read": "auth != null && (data.child('plaetze/1').val() === auth.uid || data.child('plaetze/2').val() === auth.uid)",
        "plaetze": {
          "$platz": {
            ".write": "auth != null && ($platz === '1' || $platz === '2') && (!data.exists() || data.val() === auth.uid || data.parent().child('1').val() === auth.uid)",
            ".validate": "newData.isString() && newData.val() === auth.uid"
          }
        },
        "spiel": {
          ".write": "auth != null && (data.parent().child('plaetze/1').val() === auth.uid || data.parent().child('plaetze/2').val() === auth.uid)",
          ".validate": "newData.isString() && newData.val().length < 30000"
        },
        "$sonst": {
          ".validate": false
        }
      }
    }
  }
}
